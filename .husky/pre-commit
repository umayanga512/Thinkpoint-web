#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running code quality checks..."

echo "🖼️ Optimizing images..."

# Run image optimization if script exists
if [ -f "scripts/optimize-images.js" ]; then
  bun run scripts/optimize-images.js || echo "⚠️ Image optimization failed, continuing..."
  git add src/assets/*.{webp,avif} 2>/dev/null || true
fi

# Run lint-staged for formatting and linting
bunx lint-staged

echo "🔒 Scanning for secrets..."

# Professional secret detection (placeholder - gitleaks not configured yet)
echo "⚠️  Gitleaks not configured yet - install via 'brew install gitleaks'"

echo "📏 Checking file sizes..."

# Check for large files (>1MB) 
git diff --cached --name-only | while read file; do
  if [ -f "$file" ]; then
    size=$(wc -c < "$file")
    if [ $size -gt 1048576 ]; then
      echo "❌ File $file is too large ($(($size / 1024))KB > 1MB)"
      exit 1
    fi
  fi
done

echo "✅ Pre-commit checks passed!"