{
  "$schema": "https://developers.cloudflare.com/pages/platform/schema",
  "build": {
    "command": "bun run build",
    "cwd": "."
  },
  "build.upload": {
    "format": "modules",
    "dir": "dist"
  },
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "production": {
      "NODE_ENV": "production"
    },
    "preview": {
      "NODE_ENV": "development"
    }
  },
  "cache": {
    "bypass_token": "",
    "cache_everything": false
  },
  "durable_objects": {
    "bindings": []
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "ibr-cache",
      "preview_id": "ibr-cache-preview"
    },
    {
      "binding": "SESSION",
      "id": "ibr-session",
      "preview_id": "ibr-session-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ibr-db",
      "database_id": "ibr-db-preview"
    }
  ],
  "image_service": {
    "format": "webp",
    "quality": 75,
    "compression_level": 6
  },
  "analytics_tags": [],
  "compatibility_date": "2024-10-01"
}
