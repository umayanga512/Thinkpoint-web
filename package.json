{
  "name": "ibr-web",
  "type": "module",
  "version": "0.0.2",
  "private": true,
  "packageManager": "bun@1.2.23",
  "//": "BUN-SHOP: Use ONLY 'bun install', 'bun run', 'bun add' - NEVER use npm commands",
  "scripts": {
    "dev": "astro dev",
    "dev:mobile": "astro dev --host",
    "start": "astro dev",
    "build": "astro build",
    "build:basic": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cloudflare-build": "astro build",
    "test": "playwright test",
    "test:parallel": "playwright test --workers=8",
    "test:playwright": "playwright test",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari' --project='Tablet iPad'",
    "test:a11y": "playwright test --grep 'Accessibility Tests'",
    "test:visual": "playwright test --grep 'Visual Regression Tests'",
    "lighthouse": "lhci autorun",
    "audit": "bun audit --audit-level high",
    "security:scan": "bun audit --audit-level critical",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "secrets:check": "echo 'Gitleaks not configured yet'",
    "commit": "cz",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "ci:quality": "bun run format:check && bun run lint:check && bun run build",
    "ci:performance": "bun run test && bun run lighthouse",
    "ci:security": "bun run security:scan",
    "ci": "bun run ci:quality && bun run ci:performance && bun run ci:security",
    "deploy:cloudflare": "bunx wrangler pages deploy dist --project-name=ibr-web",
    "deploy:production": "bunx wrangler pages deploy dist --project-name=ibr-web --branch=main",
    "deploy:preview": "bunx wrangler pages deploy dist --project-name=ibr-web",
    "deploy": "bun run ci && bun run deploy:production"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.6",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/montserrat": "^5.2.8",
    "@fontsource/aboreto": "^5.2.7",
    "@fontsource/kanit": "^5.2.8",
    "@iconify-json/carbon": "^1.2.13",
    "@iconify-json/logos": "^1.2.9",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/uil": "^1.2.3",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^5.14.1",
    "astro-icon": "^1.1.5",
    "astro-navbar": "^2.4.0",
    "astro-seo": "^0.8.4",
    "framer-motion": "^12.23.22",
    "ibr-web": ".",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^12.6.9",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.36.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "astro-compress": "^2.3.8",
    "axe-playwright": "^2.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.36.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-unused-imports": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "posthog-js": "^1.269.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "semantic-release": "^24.2.9",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "wrangler": "^4.41.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{astro,json,md,css}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "overrides": {
    "axios": "^1.12.0",
    "form-data": "^4.0.4",
    "devalue": "^5.3.2",
    "path-to-regexp": "^6.3.0"
  }
}
