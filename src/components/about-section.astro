---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Container from '@components/container.astro';
import Sectionhead from '@components/sectionhead.astro';
import { Icon } from 'astro-icon/components';

// Import images from available assets
import aboutHeroImage from '../assets/pexels-rdne-5922680.jpg';
import indonesiaMapImage from '../assets/pexels-kseniachernaya-3952060.jpg';

// Filter team entries with 'draft: false' & date before current date
const publishedTeamMembers = await getCollection('team', ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

// Company stats
const stats = [
  {
    number: '500+',
    label: 'Active Members',
    icon: 'carbon:partnership',
  },
  {
    number: '24/7',
    label: 'Access Available',
    icon: 'carbon:time',
  },
  {
    number: '50+',
    label: 'Study Desks',
    icon: 'carbon:workspace',
  },
  {
    number: '100%',
    label: 'High-Speed WiFi',
    icon: 'carbon:wifi',
  },
];

// Core values
const values = [
  {
    title: 'Focus',
    description: 'Dedicated quiet zones designed for deep work and concentration.',
    icon: 'carbon:task-complete',
  },
  {
    title: 'Community',
    description: 'Connect with like-minded students and freelancers in a collaborative environment.',
    icon: 'carbon:partnership',
  },
  {
    title: 'Comfort',
    description: 'Ergonomic furniture, climate control, and premium amenities for your productivity.',
    icon: 'carbon:star',
  },
  {
    title: 'Flexibility',
    description: 'Choose from daily passes, monthly memberships, or flexible booking options.',
    icon: 'carbon:calendar',
  },
];

// Client testimonials
const testimonials = [
  {
    quote:
      'ThinkPoint has been a game-changer for my freelance work. The quiet environment and fast WiFi help me stay productive throughout the day.',
    author: 'Kavindu Perera',
    position: 'Freelance Developer',
    company: 'Nugegoda, Sri Lanka',
    rating: 5,
  },
  {
    quote:
      'As a medical student, finding a quiet place to study was always challenging. ThinkPoint provides the perfect environment for focused studying.',
    author: 'Sanduni Fernando',
    position: 'Medical Student',
    company: 'University of Colombo',
    rating: 5,
  },
  {
    quote:
      'The community at ThinkPoint is amazing! I\'ve met so many talented people and even found collaboration opportunities for my startup.',
    author: 'Ashen Silva',
    position: 'Entrepreneur',
    company: 'Tech Startup Founder',
    rating: 5,
  },
];
---

<!-- About Section -->
<section id="about" class="scroll-mt-20 relative overflow-hidden">
  <!-- Background decorative elements -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-amber-200/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-yellow-200/15 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

  <!-- Hero Section -->
  <div class="relative py-10 md:py-14">
    <Container>
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 rounded-full bg-amber-100/80 px-4 py-1.5 text-sm font-medium text-amber-900 backdrop-blur-sm mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
          </span>
          Opening Soon
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-amber-950 mb-4 tracking-tight">
          About <span class="bg-gradient-to-r from-amber-700 to-yellow-600 bg-clip-text text-transparent">ThinkPoint</span>
        </h1>
        <p class="text-xl text-amber-900/70 max-w-2xl mx-auto">
          A productive workspace in Nugegoda for students and freelancers
        </p>
      </div>

      <div class="mx-auto mt-8 grid max-w-6xl gap-8 md:grid-cols-2 items-center">
        <div class="flex flex-col justify-center space-y-6 order-2 md:order-1">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-amber-950 mb-6">Our Story</h2>
            <div class="space-y-4">
              <p class="text-lg leading-relaxed text-amber-900/80">
                ThinkPoint was created with a vision to provide students and freelancers in Nugegoda
                with a dedicated space to work, study, and think without distractions.
              </p>
              <p class="text-lg leading-relaxed text-amber-900/80">
                We understand the challenges of finding a productive environment, which is why we've
                designed ThinkPoint to be more than just a space—it's a community of focused individuals.
              </p>
            </div>
          </div>
          
          <!-- Quick highlights -->
          <div class="grid grid-cols-2 gap-4 pt-4">
            <div class="bg-gradient-to-br from-amber-50 to-yellow-50/50 rounded-2xl p-5 border border-amber-200/40">
              <div class="text-3xl font-bold text-amber-700 mb-1">50+</div>
              <div class="text-sm text-amber-900/70">Study Spaces</div>
            </div>
            <div class="bg-gradient-to-br from-amber-50 to-yellow-50/50 rounded-2xl p-5 border border-amber-200/40">
              <div class="text-3xl font-bold text-amber-700 mb-1">24/7</div>
              <div class="text-sm text-amber-900/70">Access Available</div>
            </div>
          </div>
        </div>
        
        <div class="relative order-1 md:order-2">
          <!-- Decorative background -->
          <div class="absolute inset-0 bg-gradient-to-br from-amber-500/20 to-yellow-500/20 rounded-3xl blur-2xl transform rotate-3"></div>
          
          <!-- Image container -->
          <div class="relative">
            <Picture
              src={aboutHeroImage}
              formats={['avif', 'webp']}
              alt="ThinkPoint study space"
              class="relative z-10 w-full rounded-3xl object-cover shadow-2xl shadow-amber-900/20 ring-1 ring-amber-900/10"
              loading="lazy"
              width={671}
              height={480}
            />
            
            <!-- Floating badge -->
            <div class="absolute -bottom-6 -left-6 bg-white rounded-2xl px-6 py-4 shadow-xl shadow-amber-900/10 ring-1 ring-amber-900/5 z-20">
              <div class="flex items-center gap-3">
                <div class="bg-gradient-to-br from-amber-600 to-amber-700 p-3 rounded-xl">
                  <Icon name="carbon:certificate" class="h-6 w-6 text-white" />
                </div>
                <div>
                  <p class="text-sm font-semibold text-amber-900">Premium Workspace</p>
                  <p class="text-xs text-amber-900/60">Members Only</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </div>

  <!-- What We Do Section -->
  <div id="what-we-do" class="scroll-mt-20 relative py-10 md:py-14 bg-gradient-to-b from-amber-50/50 to-white">
    <Container>
      <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-2 items-center">
        <div class="relative">
          <!-- Decorative background -->
          <div class="absolute inset-0 bg-gradient-to-br from-yellow-500/20 to-amber-500/20 rounded-3xl blur-2xl transform -rotate-2"></div>
          
          <Picture
            src={indonesiaMapImage}
            widths={[476, 800]}
            sizes="(max-width: 768px) 476px, 800px"
            formats={['avif', 'webp']}
            alt="Indonesia Map"
            class="relative z-10 w-full rounded-3xl object-cover shadow-2xl shadow-amber-900/20 ring-1 ring-amber-900/10"
            loading="lazy"
            width={800}
            height={600}
          />
          
          <!-- Location badge -->
          <div class="absolute -top-4 -right-4 bg-white rounded-2xl px-5 py-3 shadow-xl shadow-amber-900/10 ring-1 ring-amber-900/5 z-20">
            <div class="flex items-center gap-2">
              <Icon name="carbon:location" class="h-5 w-5 text-amber-700" />
              <span class="text-sm font-semibold text-amber-900">Nugegoda, Sri Lanka</span>
            </div>
          </div>
        </div>
        
        <div class="flex flex-col justify-center space-y-6">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-amber-950 mb-6">What We Do</h2>
            <div class="space-y-4">
              <p class="text-lg leading-relaxed text-amber-900/80">
                ThinkPoint is a modern study centre located in the heart of Nugegoda, designed specifically
                for students and freelancers who need a distraction-free environment to focus on their work.
              </p>
              <p class="text-lg leading-relaxed text-amber-900/80">
                We offer a range of membership options, from daily passes to monthly subscriptions,
                providing the flexibility you need to work on your schedule.
              </p>
            </div>
          </div>
          
          <div class="bg-gradient-to-br from-amber-50 to-yellow-50/50 rounded-2xl p-6 border border-amber-200/40">
            <h3 class="text-xl font-bold text-amber-900 mb-4 flex items-center gap-2">
              <Icon name="carbon:star-filled" class="h-5 w-5 text-amber-600" />
              Our Amenities
            </h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 group">
                <div class="mt-0.5 bg-amber-600 rounded-full p-1 group-hover:scale-110 transition-transform">
                  <Icon name="carbon:checkmark" class="h-3 w-3 text-white" />
                </div>
                <span class="text-amber-900/80 group-hover:text-amber-900 transition-colors">High-speed fiber optic WiFi</span>
              </li>
              <li class="flex items-start gap-3 group">
                <div class="mt-0.5 bg-amber-600 rounded-full p-1 group-hover:scale-110 transition-transform">
                  <Icon name="carbon:checkmark" class="h-3 w-3 text-white" />
                </div>
                <span class="text-amber-900/80 group-hover:text-amber-900 transition-colors">Quiet study zones and collaboration areas</span>
              </li>
              <li class="flex items-start gap-3 group">
                <div class="mt-0.5 bg-amber-600 rounded-full p-1 group-hover:scale-110 transition-transform">
                  <Icon name="carbon:checkmark" class="h-3 w-3 text-white" />
                </div>
                <span class="text-amber-900/80 group-hover:text-amber-900 transition-colors">Complimentary coffee and refreshments</span>
              </li>
              <li class="flex items-start gap-3 group">
                <div class="mt-0.5 bg-amber-600 rounded-full p-1 group-hover:scale-110 transition-transform">
                  <Icon name="carbon:checkmark" class="h-3 w-3 text-white" />
                </div>
                <span class="text-amber-900/80 group-hover:text-amber-900 transition-colors">Printing and scanning facilities</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </div>

  <!-- Testimonials Section -->
  <div class="relative py-10 md:py-14 bg-gradient-to-b from-amber-50/50 to-white">
    <Container>
      <div class="mx-auto max-w-6xl">
        <div class="text-center mb-8">
          <h2 class="text-3xl md:text-4xl font-bold text-amber-950 mb-4">What Our Members Say</h2>
          <p class="text-xl text-amber-900/70 max-w-3xl mx-auto">
            Hear from students and freelancers who have made ThinkPoint their productive workspace.
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {
            testimonials.map((testimonial, index) => (
              <div class="group relative">
                {/* Card */}
                <div class="relative h-full rounded-2xl bg-white border border-amber-200/60 p-8 shadow-lg shadow-amber-900/5 transition-all duration-300 hover:shadow-2xl hover:shadow-amber-900/10 hover:-translate-y-1">
                  {/* Quote icon */}
                  <div class="absolute -left-4 -top-4 rounded-full bg-gradient-to-br from-amber-600 to-amber-700 p-3 shadow-lg shadow-amber-500/25">
                    <Icon name="carbon:quotes" class="h-6 w-6 text-white" />
                  </div>

                  {/* Rating */}
                  <div class="flex gap-1 mb-4 pt-4">
                    {Array.from({ length: testimonial.rating }).map((_, i) => (
                      <svg key={i} class="h-5 w-5 fill-amber-500" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>

                  {/* Testimonial content */}
                  <p class="text-amber-900/80 leading-relaxed mb-6 italic">"{testimonial.quote}"</p>
                  
                  {/* Author info */}
                  <div class="border-t border-amber-200/40 pt-5 mt-auto">
                    <p class="font-bold text-amber-900 mb-1">{testimonial.author}</p>
                    <p class="text-sm text-amber-900/70">{testimonial.position}</p>
                    <p class="text-sm text-amber-900/60 flex items-center gap-1 mt-1">
                      <Icon name="carbon:location" class="h-3 w-3" />
                      {testimonial.company}
                    </p>
                  </div>

                  {/* Decorative corner element */}
                  <div class="absolute -bottom-2 -right-2 w-20 h-20 bg-gradient-to-br from-amber-100/60 to-yellow-100/40 rounded-full blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </div>
</section>

<style>
  /* Container utility (if not already defined) */
  .container {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    padding-right: 1rem;
    padding-left: 1rem;
  }

  @media (min-width: 640px) {
    .container {
      max-width: 640px;
    }
  }

  @media (min-width: 768px) {
    .container {
      max-width: 768px;
    }
  }

  @media (min-width: 1024px) {
    .container {
      max-width: 1024px;
    }
  }

  @media (min-width: 1280px) {
    .container {
      max-width: 1280px;
    }
  }

  @media (min-width: 1536px) {
    .container {
      max-width: 1536px;
    }
  }

  /* Smooth scroll */
  html {
    scroll-behavior: smooth;
  }
</style>