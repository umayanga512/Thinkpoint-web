---
import { Picture } from 'astro:assets';
import Container from '@components/container.astro';
import { Icon } from 'astro-icon/components';

// Import images from available assets
import aboutHeroImage from '../assets/pexels-rdne-5922680.jpg';
import focusImage from '../assets/pexels-kseniachernaya-3952060.jpg';

// Core values from brand dossier
const values = [
  {
    title: 'Radical Silence',
    icon: 'carbon:volume-mute',
  },
  {
    title: 'Intellectual Depth',
    icon: 'carbon:chart-line',
  },
  {
    title: 'Organic Focus',
    icon: 'carbon:tree',
  },
  {
    title: 'Disciplined Solitude',
    icon: 'carbon:user',
  },
  {
    title: 'Engineered Flow',
    icon: 'carbon:arrow-right',
  },
];
---

<!-- About Section -->
<section id="about" class="scroll-mt-20 relative overflow-hidden">
  <!-- Background decorative elements -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-primary-200/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-primary-200/15 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

  <!-- Hero Section -->
  <div class="relative py-10 md:py-14">
    <Container>
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 rounded-full bg-primary-100/80 px-4 py-1.5 text-sm font-medium text-primary-900 backdrop-blur-sm mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-500"></span>
          </span>
          Opening Soon
        </div>
        <h1 class="text-4xl md:text-6xl font-serif font-bold text-primary-950 mb-4 tracking-tight">
          About <span class="bg-gradient-to-r from-primary-700 to-primary-600 bg-clip-text text-transparent">ThinkPoint</span>
        </h1>
        <p class="text-xl font-sans text-primary-900/70 max-w-2xl mx-auto">
          Sophisticated yet accessible, contemplative, serene, and deeply grounded in intellectual tradition
        </p>
      </div>

      <div class="mx-auto mt-8 grid max-w-6xl gap-12 md:grid-cols-2 items-center">
        <div class="flex flex-col justify-center space-y-6 order-2 md:order-1">
          <div>
            <h2 class="text-3xl md:text-4xl font-serif font-bold text-primary-950 mb-6">Our Story</h2>
            <div class="space-y-4">
              <p class="text-lg font-sans leading-relaxed text-primary-900/80">
                ThinkPoint began with a simple observation. Our Managing Director started his journey as a physics and mathematics tutor, teaching Ordinary Level and Advanced Level students from his home. From the beginning, his approach to education was holistic — not just about covering syllabi, but about cultivating deep understanding. And deep understanding, he realised, requires something rare: sustained focus.
              </p>
              <p class="text-lg font-sans leading-relaxed text-primary-900/80">
                Many capable, intelligent students struggled to work without distraction during lessons or exams. The problem was not ability. It was environment. At the same time, as a professional and a father, he encountered the very same challenge himself. To think clearly and produce his best, he too needed time, space, and silence.
              </p>
              <p class="text-lg font-sans leading-relaxed text-primary-900/80">
                With the belief that potential flourishes in the right conditions, he gathered the resources required to build something purposeful. Together with our Chairman and Board of Directors, the vision took shape: a dedicated environment where students, teachers, creators, and professionals could work in calm, comfort, and focus.
              </p>
            </div>
          </div>
        </div>
        
        <div class="relative order-1 md:order-2">
          <!-- Decorative background -->
          <div class="absolute inset-0 bg-gradient-to-br from-primary-500/20 to-primary-500/20 rounded-3xl blur-2xl transform rotate-3"></div>
          
          <!-- Image container -->
          <div class="relative">
            <Picture
              src={aboutHeroImage}
              formats={['avif', 'webp']}
              alt="ThinkPoint study space"
              class="relative z-10 w-full rounded-3xl object-cover shadow-2xl shadow-primary-900/20 ring-1 ring-primary-900/10"
              loading="lazy"
              width={671}
              height={480}
            />
          </div>
        </div>
      </div>
    </Container>
  </div>

  <!-- Mission & Vision Section -->
  <div class="relative py-12">
    <Container>
      <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-2">
        <div class="bg-primary-100/50 rounded-3xl p-8 border border-primary-200 backdrop-blur-sm">
          <div class="inline-flex items-center justify-center p-3 bg-primary-200/50 rounded-xl mb-6">
            <Icon name="carbon:rocket" class="h-8 w-8 text-primary-700" />
          </div>
          <h2 class="text-3xl font-bold mb-4 text-primary-950 font-serif">Our Mission</h2>
          <p class="text-lg font-sans leading-relaxed text-primary-900/80">
            To democratize the dignity of deep work by providing a silent, nature-infused, and noble environment where every mind can access its full potential without distraction.
          </p>
        </div>
        <div class="bg-primary-100/50 rounded-3xl p-8 border border-primary-200 backdrop-blur-sm">
          <div class="inline-flex items-center justify-center p-3 bg-primary-200/50 rounded-xl mb-6">
            <Icon name="carbon:view" class="h-8 w-8 text-primary-700" />
          </div>
          <h2 class="text-3xl font-bold mb-4 text-primary-950 font-serif">Our Vision</h2>
          <p class="text-lg font-sans leading-relaxed text-primary-900/80">
            To reclaim solitude as a fundamental human right, becoming Sri Lanka's sanctuary for sustained focus and intellectual discovery.
          </p>
        </div>
      </div>
    </Container>
  </div>

  <!-- Core Offer Section -->
  <div id="core-offer" class="scroll-mt-20 relative py-16 md:py-24 bg-gradient-to-b">
    <Container>
      <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-2 items-center">
        <div class="relative shadow-2xl rounded-3xl overflow-hidden group">
          <Picture
            src={import('../assets/pexels-kseniachernaya-3952060.jpg')}
            formats={['avif', 'webp']}
            alt="Deep Work Environment"
            class="relative z-10 w-full h-[600px] object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
            width={800}
            height={600}
          />
          
        </div>
        
        <div class="flex flex-col justify-center space-y-8">
          <div>
            <h2 class="text-3xl md:text-4xl font-serif font-bold text-primary-950 mb-6">Core Offer</h2>
            <div class="space-y-4">
              <p class="text-lg font-sans leading-relaxed text-primary-900/80">
                In a world of constant distraction, clarity has become rare. Nearly every meaningful breakthrough began in a moment of deep, organic focus — when the mind was uninterrupted, immersed, and quietly present. Even in the midst of society, the thinker stood apart, alone in his own universe. It is in that stillness that ideas begin to flow.
              </p>
              <p class="text-lg font-sans leading-relaxed text-primary-900/80">
                ThinkPoint exists to make that state possible. We offer a simple yet powerful solution for the busy mind: a calm, thoughtfully designed environment that removes noise and restores attention. Soft light, natural greens, and the warmth of white ash, bamboo, and cane create a space that feels grounded and alive. Comfort supports concentration, silence feels respectful rather than rigid, and high-speed connection keeps the world within reach without overwhelming it.
              </p>
              <p class="text-lg font-sans leading-relaxed text-primary-900/80">
                Books rest beside screens as reminders that knowledge unfolds patiently. Every element — the atmosphere, the materials, the light — works in quiet harmony to create the conditions for deep focus and steady progress.
              </p>
            </div>
          </div>
          
          <div class="pt-4 border-t border-primary-200">
            <h3 class="text-2xl font-serif font-bold text-primary-950 mb-6">Our Values</h3>
            <div class="flex flex-wrap gap-3">
              {values.map((value) => (
                <div class="flex items-center gap-2 bg-primary-100/50 text-primary-900 px-4 py-2 rounded-full text-sm font-medium border border-primary-200">
                  <Icon name={value.icon} class="h-4 w-4 text-primary-700" />
                  {value.title}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </Container>
  </div>
</section>

<style>
  /* Container utility (if not already defined) */
  .container {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    padding-right: 1rem;
    padding-left: 1rem;
  }

  @media (min-width: 640px) {
    .container {
      max-width: 640px;
    }
  }

  @media (min-width: 768px) {
    .container {
      max-width: 768px;
    }
  }

  @media (min-width: 1024px) {
    .container {
      max-width: 1024px;
    }
  }

  @media (min-width: 1280px) {
    .container {
      max-width: 1280px;
    }
  }

  @media (min-width: 1536px) {
    .container {
      max-width: 1536px;
    }
  }

  /* Smooth scroll */
  html {
    scroll-behavior: smooth;
  }
</style>