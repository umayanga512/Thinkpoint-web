---
interface Props {
  title?: string;
  description?: string;
  phone?: string;
  email?: string;
  web?: { label: string; url: string };
  className?: string;
}

const {
  title = "Visit ThinkPoint",
  description = "Ready to boost your productivity? Visit us in Nugegoda or get in touch to learn more about our membership options.",
  phone = "+94 77 123 4567",
  email = "hello@thinkpoint.lk",
  web = {
    label: "thinkpoint.lk",
    url: "https://thinkpoint.lk",
  },
  className = "",
} = Astro.props;
---

<section id="contact" class={`scroll-mt-20 py-10 md:py-14 ${className}`}>
  <div class="container">
    <div class="mx-auto flex max-w-7xl flex-col gap-8 lg:flex-row lg:gap-12">
      <div class="mx-auto flex max-w-sm flex-col gap-10">
        <div class="text-center lg:text-left">
          <h1 class="font-serif mb-2 text-5xl font-semibold lg:mb-1 lg:text-6xl text-primary-950">
            {title}
          </h1>
          <p class="font-sans text-gray-600 dark:text-gray-400">{description}</p>
        </div>
        <div class="mx-auto w-fit lg:mx-0">
          <h3 class="font-serif mb-6 text-center text-2xl font-semibold lg:text-left text-primary-950">
            Contact Details
          </h3>
          <ul class="font-sans ml-4 list-disc space-y-2">
            <li>
              <span class="font-bold">Location: </span>
              Next to NSB in Nugegoda
            </li>
            <li>
              <span class="font-bold">Opening Hours: </span>
              9am - 9pm (7 days a week)
            </li>
            <li>
              <span class="font-bold">Business: </span>
              ThinkPoint Educational Services Pvt Ltd
            </li>
            <li>
              <span class="font-bold">Phone: </span>
              {phone}
            </li>
            <li>
              <span class="font-bold">Email: </span>
              <a href={`mailto:${email}`} class="underline hover:no-underline">
                {email}
              </a>
            </li>
            <li>
              <span class="font-bold">Web: </span>
              <a 
                href={web.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="underline hover:no-underline"
              >
                {web.label}
              </a>
            </li>
          </ul>
        </div>
      </div>
      <!-- Contact Form -->
      <div class="mx-auto flex w-full lg:w-[40vw] flex-col rounded-lg border border-primary-200 bg-primary-100/50 p-6 shadow-sm">
        <h2 class="text-2xl font-serif font-bold text-primary-950 mb-2">Send us a message</h2>
        <p class="text-sm font-sans text-primary-900/80 mb-6">
          We'll get back to you within 24 hours.
        </p>

        <form class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="firstName" class="block text-sm font-sans font-medium text-primary-900">
                First Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                required
                class="w-full px-3 py-2 border border-primary-300 rounded-md bg-primary-50/80 text-primary-900 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
              />
            </div>
            <div class="grid w-full items-center gap-1.5">
              <label 
                for="lastName" 
                class="font-sans text-sm font-medium text-primary-900"
              >
                Last Name
              </label>
              <input
                type="text"
                id="lastName"
                name="lastName"
                required
                class="w-full px-3 py-2 border border-primary-300 rounded-md bg-primary-50/80 text-primary-900 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
              />
            </div>
          </div>
          
          <div class="grid w-full items-center gap-1.5">
            <label 
              for="email" 
              class="font-sans text-sm font-medium text-primary-900"
            >
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="Email"
              required
              class="w-full px-3 py-2 border border-primary-300 rounded-md bg-primary-50/80 text-primary-900 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            />
          </div>
          
          <div class="grid w-full items-center gap-1.5">
            <label 
              for="subject" 
              class="font-sans text-sm font-medium text-primary-900"
            >
              Subject
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="Subject"
              required
              class="w-full px-3 py-2 border border-primary-300 rounded-md bg-primary-50/80 text-primary-900 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
            />
          </div>
          
          <div class="grid w-full gap-1.5">
            <label 
              for="message" 
              class="font-sans text-sm font-medium text-primary-900"
            >
              Message
            </label>
            <textarea
              id="message"
              name="message"
              placeholder="Type your message here."
              rows="4"
              required
              class="w-full px-3 py-2 border border-primary-300 rounded-md bg-primary-50/80 text-primary-900 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent resize-none"
            ></textarea>
          </div>
          
          <button
            type="submit"
            class="font-sans w-full px-4 py-3 bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 text-white font-medium rounded-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:ring-offset-2 shadow-lg shadow-primary-500/25 hover:shadow-xl hover:shadow-primary-500/35"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>