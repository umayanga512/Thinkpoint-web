---
import { Icon } from 'astro-icon/components';

const features = [
  {
    title: 'Radical Silence',
    description:
      'A strict silence policy ensures your train of thought remains uninterrupted, allowing for deep, sustained focus.',
    icon: 'carbon:volume-mute',
  },
  {
    title: 'High-Speed Connectivity',
    description:
      'Enterprise-grade Wi-Fi keeps you connected to your work without frustrating drops or slow load times.',
    icon: 'carbon:wifi',
  },
  {
    title: 'Organic Focus',
    description:
      'Surrounded by natural tones, bamboo, cane, and greenery to reduce cognitive load and mental fatigue.',
    icon: 'carbon:tree',
  },
  {
    title: 'Ergonomic Comfort',
    description:
      'Premium task chairs and spacious desks designed specifically for long sessions of uninterrupted work.',
    icon: 'carbon:pedestrian-child',
  },
  {
    title: 'Disciplined Solitude',
    description:
      'A shared understanding among members that we are all here to focus, creating an atmosphere of productive energy.',
    icon: 'carbon:user',
  },
  {
    title: 'Flexible Access',
    description:
      'Choose from daily passes, hourly slots, or dedicated monthly spots based on your specific focus needs.',
    icon: 'carbon:time',
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl font-bold lg:text-5xl lg:tracking-tight font-serif text-primary-950">
    Everything You Need to Do Your Best Work
  </h2>
  <p class="mt-4 text-lg text-primary-900/80 font-sans">
    We've removed the friction from productivity. Every element of ThinkPoint is engineered to help you achieve flow state quickly and maintain it longer.
  </p>
</div>

<div class="mt-16 grid gap-16 sm:grid-cols-2 md:grid-cols-3">
  {
    features.map((item) => (
      <div class="flex items-start gap-4">
        <div class="mt-1 flex h-10 w-10 items-center justify-center shrink-0 rounded-full bg-primary-100 border border-primary-200">
          <Icon class="text-primary-700 h-5 w-5" name={item.icon} />
        </div>
        <div>
          <h3 class="text-lg font-semibold font-serif text-primary-950">{item.title}</h3>
          <p class="mt-2 leading-relaxed text-primary-900/70 text-sm">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
