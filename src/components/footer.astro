---
interface Footer7Props {
  logo?: {
    url: string;
    src: string;
    alt: string;
    title: string;
  };
  className?: string;
  sections?: Array<{
    title: string;
    links: Array<{ name: string; href: string }>;
  }>;
  description?: string;
  copyright?: string;
  legalLinks?: Array<{
    name: string;
    href: string;
  }>;
}

const defaultSections = [
  {
    title: "Product",
    links: [
      { name: "Overview", href: "#" },
      { name: "Pricing", href: "#" },
      { name: "Marketplace", href: "#" },
      { name: "Features", href: "#" },
    ],
  },
  {
    title: "Company",
    links: [
      { name: "About", href: "#" },
      { name: "Team", href: "#" },
      { name: "Blog", href: "#" },
      { name: "Careers", href: "#" },
    ],
  },
  {
    title: "Resources",
    links: [
      { name: "Help", href: "#" },
      { name: "Sales", href: "#" },
      { name: "Advertise", href: "#" },
      { name: "Privacy", href: "#" },
    ],
  },
  {
    title: "Legal",
    links: [
      { name: "Terms", href: "#" },
      { name: "Privacy", href: "#" },
      { name: "Cookies", href: "#" },
      { name: "Licenses", href: "#" },
    ],
  },
];

const {
  logo = {
    url: "https://www.thinkpoint.lk",
    src: "https://deifkwefumgah.cloudfront.net/shadcnblocks/block/logos/shadcnblockscom-icon.svg",
    alt: "logo",
    title: "ThinkPoint",
  },
  sections = defaultSections,
  description = "Empowering businesses with innovative solutions that drive growth and transform possibilities into reality.",
  copyright = "© 2026 ThinkPoint. All rights reserved.",
  legalLinks = [
    { name: "Terms", href: "#" },
    { name: "Privacy", href: "#" },
  ],
  className = "",
} = Astro.props;

// Simple cn utility function replacement
function cn(...classes: (string | undefined | false | null)[]) {
  return classes.filter(Boolean).join(" ");
}
---

<section class={cn("relative pt-8 pb-4 bg-gradient-to-b from-white via-amber-50/30 to-amber-100/40 overflow-hidden", className)}>
  <!-- Background decorative elements -->
  <div class="absolute top-0 left-0 w-96 h-96 bg-amber-200/20 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-yellow-200/20 rounded-full blur-3xl translate-x-1/2 translate-y-1/2"></div>
  
  <div class="container relative z-10">
    <!-- Main Footer Content -->
    <div class="flex w-full flex-col justify-between gap-8 lg:flex-row lg:gap-12">
      
      <!-- Brand Section -->
      <div class="flex w-full max-w-md flex-col gap-4">
        <!-- Logo -->
        <div class="flex items-center gap-2.5">
          <a href={logo.url} class="group flex items-center gap-2.5">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-amber-500 to-yellow-600 rounded-lg blur opacity-50 group-hover:opacity-75 transition-opacity"></div>
              <div class="relative bg-gradient-to-br from-amber-600 to-amber-700 p-2 rounded-lg">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
            </div>
            <h2 class="text-2xl font-bold bg-gradient-to-r from-amber-900 to-amber-700 bg-clip-text text-transparent">
              {logo.title}
            </h2>
          </a>
        </div>
        
        <!-- Description -->
        <p class="text-base text-amber-900/70 leading-relaxed">
          {description}
        </p>
        
        <!-- Newsletter Signup -->
        <div class="space-y-3">
          <p class="text-sm font-semibold text-amber-900">Stay updated</p>
          <div class="flex gap-2">
            <input 
              type="email" 
              placeholder="Enter your email" 
              class="flex-1 px-4 py-2.5 text-sm bg-white border border-amber-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-400 transition-all placeholder:text-amber-900/40"
            />
            <button class="px-5 py-2.5 bg-gradient-to-r from-amber-600 to-amber-700 text-white text-sm font-semibold rounded-xl hover:from-amber-700 hover:to-amber-800 transition-all duration-300 shadow-md shadow-amber-500/25 hover:shadow-lg hover:shadow-amber-500/35 active:scale-95">
              Subscribe
            </button>
          </div>
        </div>
        
        <!-- Social Links -->
        <div class="space-y-3">
          <p class="text-sm font-semibold text-amber-900">Follow us</p>
          <div class="flex items-center gap-3">
            <slot name="social-links">
              <!-- Twitter/X -->
              <a href="#" class="group flex items-center justify-center w-10 h-10 bg-white border border-amber-200 rounded-xl hover:bg-amber-50 hover:border-amber-300 transition-all duration-200 hover:scale-110 active:scale-95" aria-label="Twitter">
                <svg class="w-4 h-4 text-amber-900 group-hover:text-amber-700" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                </svg>
              </a>
              
              <!-- LinkedIn -->
              <a href="#" class="group flex items-center justify-center w-10 h-10 bg-white border border-amber-200 rounded-xl hover:bg-amber-50 hover:border-amber-300 transition-all duration-200 hover:scale-110 active:scale-95" aria-label="LinkedIn">
                <svg class="w-4 h-4 text-amber-900 group-hover:text-amber-700" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
              
              <!-- GitHub -->
              <a href="#" class="group flex items-center justify-center w-10 h-10 bg-white border border-amber-200 rounded-xl hover:bg-amber-50 hover:border-amber-300 transition-all duration-200 hover:scale-110 active:scale-95" aria-label="GitHub">
                <svg class="w-4 h-4 text-amber-900 group-hover:text-amber-700" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
              
              <!-- Instagram -->
              <a href="#" class="group flex items-center justify-center w-10 h-10 bg-white border border-amber-200 rounded-xl hover:bg-amber-50 hover:border-amber-300 transition-all duration-200 hover:scale-110 active:scale-95" aria-label="Instagram">
                <svg class="w-4 h-4 text-amber-900 group-hover:text-amber-700" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
            </slot>
          </div>
        </div>
      </div>
      
      <!-- Links Grid -->
      <div class="grid w-full gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12">
        {sections.map((section, sectionIdx) => (
          <div key={sectionIdx} class="space-y-4">
            <h3 class="text-sm font-bold text-amber-900 uppercase tracking-wider">
              {section.title}
            </h3>
            <ul class="space-y-3">
              {section.links.map((link, linkIdx) => (
                <li key={linkIdx}>
                  <a 
                    href={link.href}
                    class="group inline-flex items-center text-sm text-amber-900/70 hover:text-amber-700 transition-all duration-200"
                  >
                    <span class="relative">
                      {link.name}
                      <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-amber-600 group-hover:w-full transition-all duration-300"></span>
                    </span>
                    <svg class="w-3.5 h-3.5 ml-1 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Divider -->
    <div class="mt-8 mb-6 h-px bg-gradient-to-r from-transparent via-amber-200 to-transparent"></div>
    
    <!-- Bottom Bar -->
    <div class="flex flex-col-reverse gap-4 items-center justify-between md:flex-row">
      <!-- Copyright -->
      <div class="flex flex-col items-center gap-2 md:flex-row md:gap-4">
        <p class="text-sm text-amber-900/60 font-medium">
          {copyright}
        </p>
        <div class="hidden md:block w-px h-4 bg-amber-200"></div>
        <p class="text-xs text-amber-900/50">
          Made with ❤️ in Sri Lanka
        </p>
      </div>
      
      <!-- Legal Links -->
      <ul class="flex items-center gap-6">
        {legalLinks.map((link, idx) => (
          <li key={idx}>
            <a 
              href={link.href}
              class="text-sm text-amber-900/60 hover:text-amber-700 transition-colors duration-200 font-medium"
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
    

  </div>
</section>

<style is:global>
  /* Container styles */
  .container {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    padding-right: 1rem;
    padding-left: 1rem;
  }

  @media (min-width: 640px) {
    .container {
      max-width: 640px;
    }
  }

  @media (min-width: 768px) {
    .container {
      max-width: 768px;
    }
  }

  @media (min-width: 1024px) {
    .container {
      max-width: 1024px;
    }
  }

  @media (min-width: 1280px) {
    .container {
      max-width: 1280px;
    }
  }

  @media (min-width: 1536px) {
    .container {
      max-width: 1536px;
    }
  }

  /* Back to top button visibility */
  #back-to-top.show {
    opacity: 1;
    visibility: visible;
  }

  /* Smooth scroll */
  html {
    scroll-behavior: smooth;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const backToTopButton = document.getElementById('back-to-top');
    
    // Show/hide back to top button based on scroll position
    if (backToTopButton) {
      window.addEventListener('scroll', () => {
        if (window.pageYOffset > 300) {
          backToTopButton.classList.add('show');
        } else {
          backToTopButton.classList.remove('show');
        }
      });
      
      // Scroll to top when clicked
      backToTopButton.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }
    
    // Newsletter form submission (example)
    const newsletterForm = document.querySelector('input[type="email"]');
    // Fix: Use proper selector instead of Playwright's :has-text()
    const subscribeButton = Array.from(document.querySelectorAll('button')).find(
      button => button.textContent.trim() === 'Subscribe'
    );
    
    if (subscribeButton && newsletterForm) {
      subscribeButton.addEventListener('click', (e) => {
        e.preventDefault();
        const email = newsletterForm.value;
        
        if (email && email.includes('@')) {
          // Add your newsletter signup logic here
          console.log('Newsletter signup:', email);
          
          // Visual feedback
          subscribeButton.innerHTML = '✓ Subscribed';
          subscribeButton.classList.add('bg-green-600');
          newsletterForm.value = '';
          
          setTimeout(() => {
            subscribeButton.innerHTML = 'Subscribe';
            subscribeButton.classList.remove('bg-green-600');
          }, 3000);
        } else {
          // Show error
          newsletterForm.classList.add('border-red-400');
          setTimeout(() => {
            newsletterForm.classList.remove('border-red-400');
          }, 2000);
        }
      });
      
      // Allow Enter key to submit
      newsletterForm.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          subscribeButton.click();
        }
      });
    }
  });
</script>