---
interface Footer7Props {
  logo?: {
    url: string;
    src: string;
    alt: string;
    title: string;
  };
  className?: string;
  sections?: Array<{
    title: string;
    links: Array<{ name: string; href: string }>;
  }>;
  description?: string;
  copyright?: string;
  legalLinks?: Array<{
    name: string;
    href: string;
  }>;
}

const defaultSections = [
  {
    title: "Quick Links",
    links: [
      { name: "Home", href: "/#home" },
      { name: "About Us", href: "/#about" },
      { name: "Core Offer", href: "/#core-offer" },
      { name: "Contact Us", href: "/#contact" },
    ],
  },
  {
    title: "Legal",
    links: [
      { name: "Terms", href: "#" },
      { name: "Privacy", href: "#" },
    ],
  },
];

const {
  logo = {
    url: "https://www.thinkpoint.lk",
    src: "https://deifkwefumgah.cloudfront.net/shadcnblocks/block/logos/shadcnblockscom-icon.svg",
    alt: "logo",
    title: "ThinkPoint",
  },
  sections = defaultSections,
  description = "A dedicated space in Nugegoda where students and freelancers can study, work, and collaborate in a focused, productive environment.",
  copyright = "© 2026 ThinkPoint. All rights reserved.",
  legalLinks = [
    { name: "Terms", href: "#" },
    { name: "Privacy", href: "#" },
  ],
  className = "",
} = Astro.props;

// Simple cn utility function replacement
function cn(...classes: (string | undefined | false | null)[]) {
  return classes.filter(Boolean).join(" ");
}

import logoImg from '../assets/logo.svg';
---

<section class={cn("relative pt-8 pb-4 bg-gradient-to-b from-primary-50 via-primary-50/30 to-primary-100/40 overflow-hidden", className)}>
  <!-- Background decorative elements -->
  <div class="absolute top-0 left-0 w-96 h-96 bg-primary-200/20 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-primary-100/20 rounded-full blur-3xl translate-x-1/2 translate-y-1/2"></div>
  
  <div class="container relative z-10">
    <!-- Main Footer Content -->
    <div class="flex w-full flex-col justify-between gap-8 lg:flex-row lg:gap-12">
      
      <!-- Brand Section -->
      <div class="flex w-full max-w-md flex-col gap-4">
        <!-- Logo -->
        <div class="flex items-center gap-2.5">
          <a href={logo.url} class="group flex items-center gap-2.5">
            <img src={logoImg.src} alt={logo.alt} class="h-10 w-auto" />
            <h2 class="text-2xl font-serif font-bold bg-gradient-to-r from-primary-900 to-primary-700 bg-clip-text text-transparent">
              {logo.title}
            </h2>
          </a>
        </div>
        
        <!-- Description -->
        <p class="font-sans text-base text-primary-900/70 leading-relaxed">
          {description}
        </p>
        
        <!-- Newsletter Signup -->
        <div class="space-y-3">
          <p class="font-sans text-sm font-semibold text-primary-900">Stay updated</p>
          <div class="flex gap-2">
            <input 
              type="email" 
              placeholder="Enter your email" 
              class="font-sans flex-1 px-4 py-2.5 text-sm bg-primary-50/80 border border-primary-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-400 transition-all placeholder:text-primary-900/40"
            />
            <button class="font-sans px-5 py-2.5 bg-gradient-to-r from-primary-600 to-primary-700 text-white text-sm font-semibold rounded-xl hover:from-primary-700 hover:to-primary-800 transition-all duration-300 shadow-md shadow-primary-500/25 hover:shadow-lg hover:shadow-primary-500/35 active:scale-95">
              Subscribe
            </button>
          </div>
        </div>
        
      </div>
      
      <!-- Links Grid -->
      <div class="grid w-full gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12">
        {sections.map((section, sectionIdx) => (
          <div class="space-y-4">
            <h3 class="font-sans text-sm font-bold text-primary-900 uppercase tracking-wider">
              {section.title}
            </h3>
            <ul class="space-y-3">
              {section.links.map((link, linkIdx) => (
                <li>
                  <a 
                    href={link.href}
                    class="font-sans group inline-flex items-center text-sm text-primary-900/70 hover:text-primary-700 transition-all duration-200"
                  >
                    <span class="relative">
                      {link.name}
                      <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary-600 group-hover:w-full transition-all duration-300"></span>
                    </span>
                    <svg class="w-3.5 h-3.5 ml-1 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Divider -->
    <div class="mt-8 mb-6 h-px bg-gradient-to-r from-transparent via-primary-200 to-transparent"></div>
    
    <!-- Bottom Bar -->
    <div class="flex flex-col-reverse gap-4 items-center justify-between md:flex-row">
      <!-- Copyright -->
      <div class="flex flex-col items-center gap-2 md:flex-row md:gap-4">
        <p class="font-sans text-sm text-primary-900/60 font-medium">
          {copyright}
        </p>
        <div class="hidden md:block w-px h-4 bg-primary-200"></div>
        <p class="font-sans text-xs text-primary-900/50">
          Developed by Qrius Global
        </p>
      </div>
      
      <!-- Legal Links -->
      <ul class="flex items-center gap-6">
        {legalLinks.map((link, idx) => (
          <li>
            <a 
              href={link.href}
              class="font-sans text-sm text-primary-900/60 hover:text-primary-700 transition-colors duration-200 font-medium"
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
    

  </div>
</section>

<style is:global>
  /* Container styles */
  .container {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    padding-right: 1rem;
    padding-left: 1rem;
  }

  @media (min-width: 640px) {
    .container {
      max-width: 640px;
    }
  }

  @media (min-width: 768px) {
    .container {
      max-width: 768px;
    }
  }

  @media (min-width: 1024px) {
    .container {
      max-width: 1024px;
    }
  }

  @media (min-width: 1280px) {
    .container {
      max-width: 1280px;
    }
  }

  @media (min-width: 1536px) {
    .container {
      max-width: 1536px;
    }
  }

  /* Back to top button visibility */
  #back-to-top.show {
    opacity: 1;
    visibility: visible;
  }

  /* Smooth scroll */
  html {
    scroll-behavior: smooth;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const backToTopButton = document.getElementById('back-to-top');
    
    // Show/hide back to top button based on scroll position
    if (backToTopButton) {
      window.addEventListener('scroll', () => {
        if (window.pageYOffset > 300) {
          backToTopButton.classList.add('show');
        } else {
          backToTopButton.classList.remove('show');
        }
      });
      
      // Scroll to top when clicked
      backToTopButton.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }
    
    // Newsletter form submission (example)
    const newsletterForm = document.querySelector('input[type="email"]');
    // Fix: Use proper selector instead of Playwright's :has-text()
    const subscribeButton = Array.from(document.querySelectorAll('button')).find(
      button => button.textContent.trim() === 'Subscribe'
    );
    
    if (subscribeButton && newsletterForm) {
      subscribeButton.addEventListener('click', (e) => {
        e.preventDefault();
        const email = newsletterForm.value;
        
        if (email && email.includes('@')) {
          // Add your newsletter signup logic here
          console.log('Newsletter signup:', email);
          
          // Visual feedback
          subscribeButton.innerHTML = '✓ Subscribed';
          subscribeButton.classList.add('bg-green-600');
          newsletterForm.value = '';
          
          setTimeout(() => {
            subscribeButton.innerHTML = 'Subscribe';
            subscribeButton.classList.remove('bg-green-600');
          }, 3000);
        } else {
          // Show error
          newsletterForm.classList.add('border-red-400');
          setTimeout(() => {
            newsletterForm.classList.remove('border-red-400');
          }, 2000);
        }
      });
      
      // Allow Enter key to submit
      newsletterForm.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          subscribeButton.click();
        }
      });
    }
  });
</script>