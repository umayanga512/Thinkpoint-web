---
interface Navbar5Props {
  className?: string;
}


import logo from '../../assets/logo-no-bg.svg';

const { className = "" } = Astro.props;

const navLinks = [
  { label: 'Home', href: '/#home' },
  { label: 'About Us', href: '/#about' },
   { label: 'Core Offer', href: '/#core-offer' },
  { label: 'Contact Us', href: '/#contact' },
 
];

function cn(...classes: (string | undefined | false)[]) {
  return classes.filter(Boolean).join(" ");
}
---

<!-- Spacer -->
<div class="h-20"></div>

<section
  id="navbar"
  class={cn(
    "fixed top-0 left-0 right-0 z-20 py-3 transition-all duration-300",
    className
  )}
>
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-gradient-to-b from-primary-50/95 via-primary-50/90 to-transparent backdrop-blur-md"></div>

  <div class="container relative">
    <nav class="bg-primary-50/80 backdrop-blur-xl border border-primary-200/60 rounded-2xl shadow-lg shadow-primary-900/5 px-4 md:px-6 py-3 transition-all duration-300">
      <div class="flex items-center justify-between">
        <!-- Logo -->
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group">
          <img src={logo.src} alt="ThinkPoint Logo" class="h-7 w-auto" />
        </a>

        <!-- Desktop Nav -->
        <div class="hidden lg:flex items-center gap-1">
          {navLinks.map(link => (
            <a href={link.href} class="nav-link">{link.label}</a>
          ))}
        </div>

        <!-- Desktop CTA -->
        <div class="hidden lg:flex">
          <button class="font-sans px-6 py-2.5 text-sm font-semibold bg-gradient-to-r from-primary-600 to-primary-700 text-white rounded-xl hover:scale-[1.02] transition shadow-md shadow-primary-500/25">
            Book your spot
          </button>
        </div>

        <!-- Mobile Button -->
        <button id="mobile-menu-button" class="lg:hidden p-2.5 border border-primary-200 rounded-xl">
          <svg class="w-5 h-5 text-primary-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden">
    <div class="container mt-4">
      <div class="bg-white border border-primary-200 rounded-2xl p-4 flex flex-col gap-2 shadow-lg shadow-primary-900/5">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="font-sans block rounded-xl p-3 hover:bg-primary-50 transition text-primary-900 font-medium"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  .nav-link {
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--tw-prose-body, #544426); /* fallback to primary-900 */
    border-radius: 0.75rem;
    transition: all 0.2s;
  }

  /* using tailwind theme lookup via @apply for simpler dynamic brand theming */
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  .nav-link {
    @apply text-primary-900 font-sans;
  }

  .nav-link:hover {
    @apply bg-primary-100 text-primary-800;
  }

  .container {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 1rem;
  }
</style>

<script is:inline>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-open");
  const closeIcon = document.getElementById("menu-close");

  button?.addEventListener("click", () => {
    menu.classList.toggle("hidden");
    openIcon.classList.toggle("hidden");
    closeIcon.classList.toggle("hidden");
  });
</script>
