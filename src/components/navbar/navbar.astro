---
interface Navbar5Props {
  className?: string;
}

const {
  className = ""
} = Astro.props;

const features = [
  {
    title: "Dashboard",
    description: "Overview of your activity",
    href: "#",
  },
  {
    title: "Analytics",
    description: "Track your performance",
    href: "#",
  },
  {
    title: "Settings",
    description: "Configure your preferences",
    href: "#",
  },
  {
    title: "Integrations",
    description: "Connect with other tools",
    href: "#",
  },
  {
    title: "Storage",
    description: "Manage your files",
    href: "#",
  },
  {
    title: "Support",
    description: "Get help when needed",
    href: "#",
  },
];

// Utility function to merge class names
function cn(...classes) {
  return classes.filter(Boolean).join(" ");
}
---

<section class={cn("py-4", className)}>
  <div class="container">
    <nav class="flex items-center justify-between">
      <a
        href="https://www.shadcnblocks.com"
        class="flex items-center gap-2"
      >
        <img
          src="https://deifkwefumgah.cloudfront.net/shadcnblocks/block/logos/shadcnblockscom-icon.svg"
          class="max-h-8"
          alt="Shadcn UI Navbar"
          width="32"
          height="32"
          loading="lazy"
        />
        <span class="text-lg font-semibold tracking-tighter">
          ThinkPoint
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-6">
        <!-- Features Dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-foreground hover:text-primary transition-colors">
            Features
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="absolute left-0 top-full mt-2 w-[600px] bg-background border rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="grid grid-cols-2 p-3 gap-2">
              {features.map((feature, index) => (
                <a
                  href={feature.href}
                  key={index}
                  class="rounded-md p-3 transition-colors hover:bg-muted/70 block"
                >
                  <p class="mb-1 font-semibold text-foreground">
                    {feature.title}
                  </p>
                  <p class="text-sm text-muted-foreground">
                    {feature.description}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="#" class="px-3 py-2 text-sm font-medium text-foreground hover:text-primary transition-colors">
          Products
        </a>
        <a href="#" class="px-3 py-2 text-sm font-medium text-foreground hover:text-primary transition-colors">
          Resources
        </a>
        <a href="#" class="px-3 py-2 text-sm font-medium text-foreground hover:text-primary transition-colors">
          Contact
        </a>
      </div>

      <!-- Desktop Buttons -->
      <div class="hidden items-center gap-4 lg:flex">
        <button class="px-4 py-2 text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 rounded-md transition-colors">
          Book your spot
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-button"
        class="lg:hidden p-2 border rounded-md hover:bg-accent transition-colors"
        onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-background border-t">
    <div class="container py-4">
      <!-- Features Accordion -->
      <div class="mb-4">
        <button 
          class="flex items-center justify-between w-full py-3 text-base font-medium text-foreground hover:text-primary transition-colors"
          onclick="document.getElementById('features-content').classList.toggle('hidden')"
        >
          Features
          <svg class="w-4 h-4 transition-transform" id="features-arrow">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div id="features-content" class="hidden pl-4">
          <div class="grid md:grid-cols-2 gap-2 py-2">
            {features.map((feature, index) => (
              <a
                href={feature.href}
                key={index}
                class="rounded-md p-3 transition-colors hover:bg-muted/70 block"
              >
                <p class="mb-1 font-semibold text-foreground">
                  {feature.title}
                </p>
                <p class="text-sm text-muted-foreground">
                  {feature.description}
                </p>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Other Links -->
      <div class="flex flex-col gap-3 py-2">
        <a href="#" class="py-2 font-medium text-foreground hover:text-primary transition-colors">
          Templates
        </a>
        <a href="#" class="py-2 font-medium text-foreground hover:text-primary transition-colors">
          Blog
        </a>
        <a href="#" class="py-2 font-medium text-foreground hover:text-primary transition-colors">
          Pricing
        </a>
      </div>

      <!-- Mobile Buttons -->
      <div class="mt-6 flex flex-col gap-3">
        <button class="w-full px-4 py-2 text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 rounded-md transition-colors">
          Book your spot
        </button>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* CSS Variables for colors - these should be defined in your global CSS */
  /* If not, uncomment the section below */

  /*
  :root {
    --background: hsl(0 0% 100%);
    --foreground: hsl(222.2 84% 4.9%);
    --primary: hsl(221.2 83.2% 53.3%);
    --primary-foreground: hsl(210 40% 98%);
    --muted: hsl(210 40% 96.1%);
    --muted-foreground: hsl(215.4 16.3% 46.9%);
    --accent: hsl(210 40% 96.1%);
    --accent-foreground: hsl(222.2 47.4% 11.2%);
    --border: hsl(214.3 31.8% 91.4%);
  }

  .dark {
    --background: hsl(222.2 84% 4.9%);
    --foreground: hsl(210 40% 98%);
    --primary: hsl(217.2 91.2% 59.8%);
    --primary-foreground: hsl(222.2 47.4% 11.2%);
    --muted: hsl(217.2 32.6% 17.5%);
    --muted-foreground: hsl(215 20.2% 65.1%);
    --accent: hsl(217.2 32.6% 17.5%);
    --accent-foreground: hsl(210 40% 98%);
    --border: hsl(217.2 32.6% 17.5%);
  }
  */

  /* If you're using Tailwind, you don't need these CSS variables */
  /* The classes below are for compatibility */

  .bg-background {
    background-color: var(--background, #ffffff);
  }
  
  .text-foreground {
    color: var(--foreground, #111827);
  }
  
  .text-primary {
    color: var(--primary, #3b82f6);
  }
  
  .bg-primary {
    background-color: var(--primary, #3b82f6);
  }
  
  .text-primary-foreground {
    color: var(--primary-foreground, #ffffff);
  }
  
  .text-muted-foreground {
    color: var(--muted-foreground, #6b7280);
  }
  
  .border {
    border-color: var(--border, #e5e7eb);
  }
  
  .border-input {
    border-color: var(--border, #e5e7eb);
  }
  
  .bg-accent {
    background-color: var(--accent, #f3f4f6);
  }
  
  .text-accent-foreground {
    color: var(--accent-foreground, #111827);
  }
  
  .hover\:bg-accent:hover {
    background-color: var(--accent, #f3f4f6);
  }
  
  .hover\:text-accent-foreground:hover {
    color: var(--accent-foreground, #111827);
  }
  
  .hover\:bg-primary\/90:hover {
    background-color: color-mix(in srgb, var(--primary, #3b82f6) 90%, transparent);
  }

  .hover\:text-primary:hover {
    color: var(--primary, #3b82f6);
  }

  .transition-colors {
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  /* Dropdown styles */
  .group:hover .group-hover\:opacity-100 {
    opacity: 1;
  }
  .group:hover .group-hover\:visible {
    visibility: visible;
  }

  /* Animation for dropdown */
  .opacity-0 {
    opacity: 0;
  }
  .invisible {
    visibility: hidden;
  }
  .group-hover\:opacity-100 {
    opacity: 0;
  }
  .group-hover\:visible {
    visibility: hidden;
  }

  /* Shadow and border radius */
  .shadow-lg {
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
  
  .rounded-lg {
    border-radius: 0.5rem;
  }
  
  .rounded-md {
    border-radius: 0.375rem;
  }

  /* Container styles */
  .container {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    padding-right: 1rem;
    padding-left: 1rem;
  }

  @media (min-width: 640px) {
    .container {
      max-width: 640px;
    }
  }

  @media (min-width: 768px) {
    .container {
      max-width: 768px;
    }
  }

  @media (min-width: 1024px) {
    .container {
      max-width: 1024px;
    }
  }

  @media (min-width: 1280px) {
    .container {
      max-width: 1280px;
    }
  }

  @media (min-width: 1536px) {
    .container {
      max-width: 1536px;
    }
  }
</style>

<script is:inline>
  // Handle mobile menu toggle
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const featuresButton = document.querySelector('button[onclick*="features-content"]');
    const featuresContent = document.getElementById('features-content');
    
    if (mobileMenuButton) {
      mobileMenuButton.addEventListener('click', (e) => {
        e.stopPropagation();
        mobileMenu.classList.toggle('hidden');
      });
    }

    if (featuresButton && featuresContent) {
      featuresButton.addEventListener('click', (e) => {
        e.stopPropagation();
        featuresContent.classList.toggle('hidden');
        const isExpanded = !featuresContent.classList.contains('hidden');
        featuresButton.setAttribute('aria-expanded', isExpanded);
        
        // Rotate arrow
        const arrow = featuresButton.querySelector('svg');
        if (arrow) {
          arrow.style.transform = isExpanded ? 'rotate(180deg)' : 'rotate(0)';
        }
      });
    }

    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileMenuButton = document.getElementById('mobile-menu-button');
      
      if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
        if (!mobileMenu.contains(e.target) && (!mobileMenuButton || !mobileMenuButton.contains(e.target))) {
          mobileMenu.classList.add('hidden');
        }
      }
    });

    // Close mobile menu when clicking a link inside it
    document.querySelectorAll('#mobile-menu a').forEach(link => {
      link.addEventListener('click', () => {
        const mobileMenu = document.getElementById('mobile-menu');
        if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
        }
      });
    });
  });
</script>