---
interface Navbar5Props {
  className?: string;
}

const { className = "" } = Astro.props;

const features = [
  {
    title: "Dashboard",
    description: "Overview of your activity",
    href: "#",
    icon: "📊",
  },
  {
    title: "Analytics",
    description: "Track your performance",
    href: "#",
    icon: "📈",
  },
  {
    title: "Settings",
    description: "Configure your preferences",
    href: "#",
    icon: "⚙️",
  },
  {
    title: "Integrations",
    description: "Connect with other tools",
    href: "#",
    icon: "🔗",
  },
  {
    title: "Storage",
    description: "Manage your files",
    href: "#",
    icon: "💾",
  },
  {
    title: "Support",
    description: "Get help when needed",
    href: "#",
    icon: "💬",
  },
];

function cn(...classes: (string | undefined | false)[]) {
  return classes.filter(Boolean).join(" ");
}
---

<!-- Spacer -->
<div class="h-20"></div>

<section
  id="navbar"
  class={cn(
    "fixed top-0 left-0 right-0 z-20 py-3 transition-all duration-300",
    className
  )}
>
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-gradient-to-b from-amber-50/95 via-amber-50/90 to-transparent backdrop-blur-md"></div>

  <div class="container relative">
    <nav class="bg-white/80 backdrop-blur-xl border border-amber-200/60 rounded-2xl shadow-lg shadow-amber-900/5 px-4 md:px-6 py-3 transition-all duration-300">
      <div class="flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group">
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-amber-500 to-yellow-600 rounded-lg blur opacity-50 group-hover:opacity-75 transition-opacity"></div>
            <div class="relative bg-gradient-to-br from-amber-600 to-amber-700 p-2 rounded-lg">
              
            </div>
          </div>
          <span class="text-xl font-bold bg-gradient-to-r from-amber-900 to-amber-700 bg-clip-text text-transparent">
            ThinkPoint
          </span>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden lg:flex items-center gap-1">
          <!-- Features Dropdown -->
          <div class="relative group">
            <button class="flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-amber-900 hover:text-amber-700 hover:bg-amber-50/50 rounded-xl transition-all">
              Features
              <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Mega menu -->
            <div class="absolute left-0 top-full mt-2 w-[620px] bg-white/95 backdrop-blur-xl border border-amber-200/60 rounded-2xl shadow-2xl shadow-amber-900/10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 -translate-y-2 group-hover:translate-y-0">
              <div class="absolute -top-2 left-8 w-4 h-4 bg-white border-l border-t border-amber-200/60 rotate-45"></div>

              <div class="grid grid-cols-2 gap-2 p-4">
                {features.map((feature) => (
                  <a
                    href={feature.href}
                    class="group rounded-xl p-4 hover:bg-gradient-to-br hover:from-amber-50 hover:to-yellow-50/50 border border-transparent hover:border-amber-200/40 transition"
                  >
                    <div class="flex gap-3">
                      <span class="text-2xl group-hover:scale-110 transition">
                        {feature.icon}
                      </span>
                      <div>
                        <p class="font-semibold text-amber-900">{feature.title}</p>
                        <p class="text-sm text-amber-800/60">
                          {feature.description}
                        </p>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <a href="#products" class="nav-link">Products</a>
          <a href="#resources" class="nav-link">Resources</a>
          <a href="#contact" class="nav-link">Contact</a>
        </div>

        <!-- Desktop CTA -->
        <div class="hidden lg:flex">
          <button class="px-6 py-2.5 text-sm font-semibold bg-gradient-to-r from-amber-600 to-amber-700 text-white rounded-xl hover:scale-[1.02] transition">
            Book your spot
          </button>
        </div>

        <!-- Mobile Button -->
        <button id="mobile-menu-button" class="lg:hidden p-2.5 border border-amber-200 rounded-xl">
          <svg class="w-5 h-5 text-amber-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden">
    <div class="container mt-4">
      <div class="bg-white border border-amber-200 rounded-2xl p-6">
        {features.map((feature) => (
          <a
            href={feature.href}
            class="block rounded-xl p-3 hover:bg-amber-50 transition"
          >
            <div class="flex gap-3">
              <span class="text-xl">{feature.icon}</span>
              <div>
                <p class="font-semibold text-amber-900 text-sm">{feature.title}</p>
                <p class="text-xs text-amber-800/60">{feature.description}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  .nav-link {
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(120 53 15);
    border-radius: 0.75rem;
    transition: all 0.2s;
  }

  .nav-link:hover {
    background: rgb(254 243 199);
    color: rgb(180 83 9);
  }

  .container {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 1rem;
  }
</style>

<script is:inline>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-open");
  const closeIcon = document.getElementById("menu-close");

  button?.addEventListener("click", () => {
    menu.classList.toggle("hidden");
    openIcon.classList.toggle("hidden");
    closeIcon.classList.toggle("hidden");
  });
</script>
