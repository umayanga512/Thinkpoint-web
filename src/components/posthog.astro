  // Enhanced Event Tracking for Indo Bintang Rezki
  document.addEventListener('DOMContentLoaded', function () {
    // Track page load performance
    window.addEventListener('load', function () {
      if (window.performance && window.performance.timing) {
        const loadTime =
          window.performance.timing.loadEventEnd - window.performance.timing.navigationStart;
        posthog.capture('page_load_completed', {
          load_time_ms: loadTime,
          page_type: document.body.dataset.pageType || 'unknown',
          is_mobile: window.innerWidth <= 768,
        });
      }
    });

    // Track scroll depth with more granular intervals
    let maxScroll = 0;
    let scrollMilestones = [10, 25, 50, 75, 90];

    window.addEventListener('scroll', function () {
      const scrollPercent = Math.round(
        (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100
      );

      scrollMilestones.forEach((milestone) => {
        if (scrollPercent >= milestone && maxScroll < milestone) {
          posthog.capture('scroll_depth_milestone', {
            percentage: milestone,
            page_url: window.location.href,
            page_title: document.title,
            timestamp: new Date().toISOString(),
          });
          maxScroll = milestone;
        }
      });
    });

    // Track link clicks with enhanced categorization
    document.addEventListener('click', function (e) {
      const link = e.target.closest('a');
      if (link) {
        const href = link.getAttribute('href');
        const text = link.textContent?.trim();
        const isExternal =
          href && href.startsWith('http') && !href.includes(window.location.hostname);
        const isPhone = href && href.startsWith('tel:');
        const isEmail = href && href.startsWith('mailto:');

        let linkCategory = 'internal';
        if (isExternal) linkCategory = 'external';
        else if (isPhone) linkCategory = 'phone';
        else if (isEmail) linkCategory = 'email';

        posthog.capture('link_clicked', {
          link_text: text || '[no-text]',
          link_url: href || '[no-href]',
          link_category: linkCategory,
          page_url: window.location.href,
          page_section: link.closest('section')?.id || 'unknown',
        });
      }
    });

    // Track button interactions
    document.addEventListener('click', function (e) {
      const button = e.target.closest('button');
      if (button) {
        const buttonText =
          button.textContent?.trim() || button.getAttribute('aria-label') || '[no-text]';
        const buttonType = button.getAttribute('type') || 'button';
        const isSubmit = buttonType === 'submit';

        posthog.capture('button_clicked', {
          button_text: buttonText,
          button_type: buttonType,
          is_form_submit: isSubmit,
          page_url: window.location.href,
          page_section: button.closest('section')?.id || 'unknown',
        });
      }
    });

    // Track form interactions
    document.addEventListener('submit', function (e) {
      const form = e.target;
      if (form.tagName === 'FORM') {
        const formId = form.id || 'unknown';
        const formAction = form.action || 'current-page';
        const isContactForm = form.classList.contains('contact-form') || formId.includes('contact');

        posthog.capture('form_submitted', {
          form_id: formId,
          form_action: formAction,
          form_type: isContactForm ? 'contact' : 'other',
          page_url: window.location.href,
        });
      }
    });

    // Track form field focus
    document.addEventListener(
      'focus',
      function (e) {
        const field = e.target;
        if (
          field.tagName === 'INPUT' ||
          field.tagName === 'TEXTAREA' ||
          field.tagName === 'SELECT'
