        const navText = navItem.textContent?.trim() || '[no-text]';
        const navHref = navItem.getAttribute('href') || '[no-href]';

        posthog.capture('navigation_clicked', {
          nav_item: navText,
          nav_destination: navHref,
          is_external: navHref.startsWith('http') && !navHref.includes(window.location.hostname),
          page_url: window.location.href,
        });
      }
    });

    // Track social media links
    document.addEventListener('click', function (e) {
      const socialLink = e.target.closest(
        'a[href*="facebook"], a[href*="twitter"], a[href*="instagram"], a[href*="linkedin"]'
      );
      if (socialLink) {
        const platform = socialLink.href.includes('facebook')
          ? 'facebook'
          : socialLink.href.includes('twitter')
            ? 'twitter'
            : socialLink.href.includes('instagram')
              ? 'instagram'
              : socialLink.href.includes('linkedin')
