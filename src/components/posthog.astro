    // Track pricing page interactions
    document.addEventListener('click', function (e) {
      const pricingItem = e.target.closest('.pricing-plan, .price-card, [data-price]');
      if (pricingItem) {
        const planName =
          pricingItem.getAttribute('data-plan') ||
          pricingItem.querySelector('.plan-name, .title')?.textContent?.trim() ||
          'unknown';
        const price = pricingItem.getAttribute('data-price') || 'unknown';

        posthog.capture('pricing_plan_selected', {
          plan_name: planName,
          price: price,
          page_url: window.location.href,
        });
      }
    });

    // Track mobile-specific interactions
    if ('ontouchstart' in window) {
      document.addEventListener(
        'touchstart',
        function (e) {
          const touchedElement = e.target;
          const elementType = touchedElement.tagName.toLowerCase();
          const hasClickListener = touchedElement.onclick !== null;

          posthog.capture('mobile_touch_interaction', {
            element_type: elementType,
            has_click_handler: hasClickListener,
            page_url: window.location.href,
          });
        },
        { passive: true }
      );
    }

    // Track performance metrics
    if ('PerformanceObserver' in window) {
      const observer = new PerformanceObserver((list) => {
        list.getEntries().forEach((entry) => {
          if (entry.entryType === 'navigation') {
            posthog.capture('navigation_timing', {
              dom_content_loaded: entry.domContentLoadedEventEnd - entry.domContentLoadedEventStart,
              load_complete: entry.loadEventEnd - entry.loadEventStart,
              page_url: window.location.href,
            });
          }
        });
      });
      observer.observe({ entryTypes: ['navigation'] });
    }

    // Make advanced tracking functions globally available
    window.trackCustomEvent = function (eventName, properties = {}) {
      posthog.capture(eventName, {
        ...properties,
        timestamp: new Date().toISOString(),
        page_url: window.location.href,
        page_title: document.title,
        user_agent: navigator.userAgent,
      });
    };

    window.trackUserJourney = function (step, details = {}) {
      posthog.capture('user_journey_step', {
        step_name: step,
        step_details: details,
        session_id: posthog.get_session_id(),
        page_url: window.location.href,
      });
    };

    // Initialize with a page view event (in addition to automatic tracking)
    posthog.capture('page_view_enhanced', {
      page_type: document.body.dataset.pageType || 'unknown',
      viewport_width: window.innerWidth,
      viewport_height: window.innerHeight,
      is_mobile: window.innerWidth <= 768,
      referrer: document.referrer,
      utm_source: new URLSearchParams(window.location.search).get('utm_source'),
      utm_medium: new URLSearchParams(window.location.search).get('utm_medium'),
      utm_campaign: new URLSearchParams(window.location.search).get('utm_campaign'),
    });
  });
</script>
