    // Track language or region preferences (if applicable)
    document.addEventListener('click', function (e) {
      const langSelector = e.target.closest('[data-lang], .language-selector, .region-selector');
      if (langSelector) {
        const selectedLang =
          langSelector.getAttribute('data-lang') || langSelector.textContent?.trim() || 'unknown';

        posthog.capture('language_preference_changed', {
          selected_language: selectedLang,
