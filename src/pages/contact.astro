---
import Contactform from '@components/contactform.astro';
import Container from '@components/container.astro';
import Sectionhead from '@components/sectionhead.astro';
import Layout from '@layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contact Us</Fragment>
      <Fragment slot="desc">We're here to answer your questions and help with your needs</Fragment>
    </Sectionhead>

    <div
      class="mx-auto mt-8 grid max-w-6xl gap-8 px-4 sm:mt-16 sm:px-0 md:grid-cols-1 lg:grid-cols-5 lg:gap-10">
      <!-- Contact Information Column -->
      <div class="lg:col-span-2">
        <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm sm:p-8">
          <h2 class="mb-4 text-xl font-bold text-gray-800 sm:mb-6 sm:text-2xl">Get in Touch</h2>

          <!-- Email -->
          <div class="mb-6 flex items-start space-x-3 sm:mb-8 sm:space-x-4">
            <div class="mt-1 rounded-lg bg-[#DFF5E9] p-2 sm:p-3">
              <Icon class="h-5 w-5 text-gray-700 sm:h-6 sm:w-6" name="carbon:email" />
            </div>
            <div>
              <h3 class="mb-1 text-sm font-semibold text-gray-800 sm:text-base">Email</h3>
              <a
                href="mailto:hello@thinkpoint.lk"
                class="break-words text-sm text-slate-600 transition-colors hover:text-black sm:text-base">
                hello@thinkpoint.lk
              </a>
            </div>
          </div>

          <!-- Phone -->
          <div class="mb-6 flex items-start space-x-3 sm:mb-8 sm:space-x-4">
            <div class="mt-1 rounded-lg bg-[#DFF5E9] p-2 sm:p-3">
              <Icon class="h-5 w-5 text-gray-700 sm:h-6 sm:w-6" name="carbon:phone" />
            </div>
            <div>
              <h3 class="mb-1 text-sm font-semibold text-gray-800 sm:text-base">Phone</h3>
              <a
                href="tel:+94771234567"
                class="text-sm text-slate-600 transition-colors hover:text-black sm:text-base">
                +94 77 123 4567
              </a>
            </div>
          </div>

          <!-- Jakarta Office -->
          <div class="mb-6 flex items-start space-x-3 sm:mb-8 sm:space-x-4">
            <div class="mt-1 rounded-lg bg-[#DFF5E9] p-2 sm:p-3">
              <Icon class="h-5 w-5 text-gray-700 sm:h-6 sm:w-6" name="carbon:location" />
            </div>
            <div>
              <h3 class="mb-1 text-sm font-semibold text-gray-800 sm:text-base">ThinkPoint Nugegoda</h3>
              <p class="text-sm text-slate-600 sm:text-base">
                No. 123, High Level Road,<br />
                Nugegoda,<br />
                Sri Lanka
              </p>
              <a
                href="https://maps.google.com/?q=Nugegoda+Sri+Lanka"
                target="_blank"
                class="mt-1 inline-flex items-center text-sm text-blue-600 transition-colors hover:text-blue-800 sm:text-base">
                <span>View on Google Maps</span>
                <Icon class="ml-1 h-4 w-4" name="carbon:arrow-up-right" />
              </a>
            </div>
          </div>

          <div class="flex items-start space-x-3 sm:space-x-4">
            <div class="mt-1 rounded-lg bg-[#DFF5E9] p-2 sm:p-3">
              <Icon class="h-5 w-5 text-gray-700 sm:h-6 sm:w-6" name="carbon:time" />
            </div>
            <div>
              <h3 class="mb-1 text-sm font-semibold text-gray-800 sm:text-base">
                Opening Hours
              </h3>
              <p class="text-sm text-slate-600 sm:text-base">
                Monday - Friday: 8:00 AM - 10:00 PM<br />
                Saturday - Sunday: 9:00 AM - 9:00 PM<br />
                <span class="mt-1 inline-block font-semibold text-amber-700">24/7 Access for Premium Members</span>
              </p>
            </div>
          </div>

          <!-- Social Media Links -->
          <div class="mt-10 border-t border-gray-100 pt-8">
            <h3 class="mb-4 font-semibold text-gray-800">Connect With Us</h3>
            <div class="flex space-x-4">
              <a
                href="#"
                class="rounded-full bg-[#DFF5E9] p-3 transition-colors hover:bg-[#DFF5E9]/70">
                <Icon class="h-5 w-5 text-gray-700" name="carbon:logo-linkedin" />
              </a>
              <a
                href="#"
                class="rounded-full bg-[#DFF5E9] p-3 transition-colors hover:bg-[#DFF5E9]/70">
                <Icon
                  href="https://www.instagram.com/indobintangrezki"
                  class="h-5 w-5 text-gray-700"
                  name="carbon:logo-instagram"
                />
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form Column -->
      <div class="lg:col-span-3">
        <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm sm:p-8">
          <h2 class="mb-4 text-xl font-bold text-gray-800 sm:mb-6 sm:text-2xl">
            Send us a Message
          </h2>
          <Contactform />
        </div>
      </div>
    </div>
  </Container>
</Layout>
